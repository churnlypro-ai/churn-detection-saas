NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Churnly <noreply@yourdomain.com>
STRIPE_PUBLIC_KEY=pk_live_your-stripe-public-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_APP_URL=https://your-domain.com
CRON_SECRET=your-cron-secret
STRIPE_PRICE_150=price_your-price-id
STRIPE_PRICE_250=price_your-price-id
STRIPE_PRICE_400=price_your-price-id
STRIPE_PRICE_600=price_your-price-id
STRIPE_PRICE_800=price_your-price-id
# Stripe Connect (import direct des clients depuis le compte Stripe d'un
# utilisateur, voir app/api/stripe/connect/*) — client_id obtenu en activant
# Connect dans Paramètres > Connect sur le dashboard Stripe, pas secret.
STRIPE_CONNECT_CLIENT_ID=ca_your-connect-client-id
# Secret dédié à la signature du paramètre "state" OAuth (anti-CSRF) —
# une chaîne aléatoire longue générée une fois, jamais partagée.
STRIPE_CONNECT_STATE_SECRET=a-long-random-secret-you-generate-once
